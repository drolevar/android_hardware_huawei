java_library {
    name: "androidx.camera.extensions.impl",
    installable: true,
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    vendor: true,
}

prebuilt_etc {
    name: "huawei_blanc_camera_extensions.xml",
    src: "camera_extensions.xml",
    filename: "camera_extensions.xml",
    sub_dir: "permissions",
    vendor: true,
}
