type hal_libteec_default, domain;
typealias hal_libteec_default alias vendor_hal_hisi_libteec_default;
hal_server_domain(hal_libteec_default, vendor_hal_hisi_libteec)

type hal_libteec_default_exec, exec_type, vendor_file_type, file_type;
typealias hal_libteec_default_exec alias vendor_hal_hisi_libteec_default_exec;
init_daemon_domain(hal_libteec_default)

typeattribute hal_libteec_default data_between_core_and_vendor_violators;

allow hal_libteec_default {
    vendor_teecd_data_file
    teecd_data_file_system
}:dir create_dir_perms;
allow hal_libteec_default {
    vendor_teecd_data_file
    teecd_data_file_system
}:file create_file_perms;
allow hal_libteec_default {
    vendor_teecd_data_file
    teecd_data_file_system
}:lnk_file create_file_perms;

allow hal_libteec_default system_data_file:dir { getattr search };
allow hal_libteec_default domain:process getattr;
r_dir_file(hal_libteec_default, domain)

hal_client_domain(vendor_hal_drm_widevine, vendor_hal_hisi_libteec)
hal_client_domain(hal_drm_default, vendor_hal_hisi_libteec)
