# Mount points for Kirin vendor/odm partitions and bind mounts
allow init {
    teecd_data_file
    splashtwo_file
    hisee_data_file
    modem_file
    modem_vendor_file
    vendor_configs_file
}:dir mounton;

allow init {
    hisee_data_file
    modem_vendor_file
}:filesystem { mount remount unmount getattr relabelfrom relabelto };

allow modem_vendor_file self:filesystem associate;

# Early block symlink relabeling and ueventd symlink inspection for oeminfo
allow init vendor_oeminfo_nvm_device:{ blk_file lnk_file } relabelto;
allow ueventd vendor_oeminfo_nvm_device:lnk_file { read getattr };
r_dir_file(init, sysfs_hisi_connectivity)
