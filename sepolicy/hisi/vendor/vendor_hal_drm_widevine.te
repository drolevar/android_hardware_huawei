type vendor_hal_drm_widevine, domain;
hal_server_domain(vendor_hal_drm_widevine, hal_drm)

type vendor_hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_drm_widevine)

allow vendor_hal_drm_widevine vendor_data_file:dir search;
allow vendor_hal_drm_widevine vendor_mediadrm_data_file:dir create_dir_perms;
allow vendor_hal_drm_widevine vendor_mediadrm_data_file:file create_file_perms;
