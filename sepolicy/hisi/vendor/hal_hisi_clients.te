# Kirin 970 HALs and charger_vendor rules grounded in .225 policy

# Keymaster & Gatekeeper
allow hal_keymaster_default kmsg_device:chr_file { getattr open read write };
allow hal_keymaster_default self:global_capability2_class_set syslog;
allow hal_keymaster_default vendor_logcat_data_file:dir create_dir_perms;
allow hal_keymaster_default vendor_logcat_data_file:file create_file_perms;
get_prop(hal_gatekeeper_default, logd_prop)

# Xcollie vendor property for libxcollie.so-linked Kirin HALs
set_prop({
    hal_keymaster_default
    hal_camera_default
    hal_graphics_composer_default
    hal_audio_default
    hal_bluetooth_default
    hal_sensors_default
    hal_fingerprint_default
    hal_power_default
    hal_wifi_default
    hal_gnss_default
    mediacodec
    vendor_hal_hisi_display_default
    vendor_hal_hisi_perf_default
}, vendor_xcollie_prop)

# Graphics allocator (Mali gralloc)
allow hal_graphics_allocator_default graphics_device:dir search;
allow hal_graphics_allocator_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default ion_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default gpu_device:chr_file rw_file_perms;
allow {
    vendor_hal_hisi_display_default
    vendor_hal_hisi_media_default
    hal_sensors_default
} hal_graphics_allocator_default:fd use;

# Graphics composer, HiSilicon display & media HALs
vndbinder_use(hal_graphics_composer_default)
vndbinder_use(vendor_hal_hisi_display_default)
vndbinder_use(vendor_hal_hisi_media_default)

# Legacy ION compatibility (Android 17 plat_sepolicy dropped ion_device in favor of dmabuf_system_heap_device)
allow {
    appdomain
    -isolated_app_all
} ion_device:chr_file r_file_perms;
allow {
    bootanim
    cameraserver
    hal_camera_default
    hal_sensors_default
    isolated_compute_app
    mediacodec
    mediaserver
    mediaswcodec
    mediatranscoding
    surfaceflinger
    system_server
    zygote
} ion_device:chr_file r_file_perms;

hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)
hal_client_domain(hal_graphics_composer_default, vendor_hal_hisi_display)
hal_client_domain(hal_graphics_composer_default, vendor_hal_hisi_perf)
hal_client_domain(mediacodec, vendor_hal_hisi_display)
hal_client_domain(hal_camera_default, vendor_hal_hisi_display)
hal_client_domain(hal_camera_default, vendor_hal_hisi_perf)
hal_client_domain(hal_camera_default, vendor_hal_hisi_libteec)
hal_client_domain(hal_camera_default, vendor_hal_hisi_hwfactoryinterface)
hal_client_domain(hal_camera_default, hal_camera)
hal_client_domain(hal_camera_default, hal_sensors)
hal_client_domain(hal_camera_default, hal_graphics_allocator)
hal_client_domain(hal_camera_default, hal_memtrack)
binder_call(hal_camera_default, system_server)
binder_call(system_server, hal_camera_default)

allow {
    hal_graphics_composer_default
    vendor_hal_hisi_display_default
    vendor_hal_hisi_media_default
} { graphics_device gpu_device ion_device }:chr_file rw_file_perms;
allow { hal_graphics_composer_default vendor_hal_hisi_display_default vendor_hal_hisi_media_default } graphics_device:dir search;
allow vendor_hal_hisi_media_default {
    vendor_jpu_device
    vendor_vdec_device
    vendor_venc_device
    vendor_cambuf_device
}:chr_file rw_file_perms;
allow mediacodec { vendor_vdec_device vendor_venc_device vendor_jpu_device }:chr_file rw_file_perms;

r_dir_file({ hal_graphics_composer_default vendor_hal_hisi_display_default }, sysfs_framebuffer)
allow { hal_graphics_composer_default vendor_hal_hisi_display_default } sysfs_framebuffer:file rw_file_perms;
r_dir_file({ hal_graphics_composer_default vendor_hal_hisi_display_default }, sysfs_devfreq_dir)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow { hal_graphics_composer_default vendor_hal_hisi_display_default } {
    vendor_hwcdump_data_file
    vendor_logcat_data_file
}:dir create_dir_perms;
allow { hal_graphics_composer_default vendor_hal_hisi_display_default } {
    vendor_hwcdump_data_file
    vendor_logcat_data_file
}:file create_file_perms;
get_prop(hal_graphics_composer_default, vendor_display_prop)
set_prop(vendor_hal_hisi_display_default, vendor_display_prop)
get_prop({ hal_graphics_composer_default hal_graphics_allocator_default }, vendor_camera_prop)

# Health HAL & offline charger
r_dir_file({ hal_health_default charger_vendor }, sysfs_type)
allow { hal_health_default charger_vendor } {
    sysfs
    sysfs_batteryinfo
    sysfs_power
    sysfs_pg
}:file rw_file_perms;
allow { hal_health_default charger_vendor } splashtwo_file:dir create_dir_perms;
allow { hal_health_default charger_vendor } splashtwo_file:file create_file_perms;
allow charger_vendor kmsg_device:chr_file { getattr open write };

# NFC
allow hal_nfc_default nfc_device:chr_file rw_file_perms;
allow hal_nfc_default vendor_nfc_data_file:dir create_dir_perms;
allow hal_nfc_default vendor_nfc_data_file:file create_file_perms;
r_dir_file(hal_nfc_default, sysfs_type)
allow hal_nfc_default { sysfs_nfc_power_writable sysfs_hisee }:file rw_file_perms;

# Secure Element (HiSEE)
allow hal_secure_element_default sysfs_hisee:dir r_dir_perms;
allow hal_secure_element_default sysfs_hisee:file rw_file_perms;
r_dir_file(hal_secure_element_default, hisee_data_file)
r_dir_file(hal_secure_element_default, sysfs_nfc_power_writable)
hal_client_domain(hal_secure_element_default, vendor_hal_hisi_libteec)
hal_client_domain(hal_secure_element_default, hal_nfc)
hal_client_domain(hal_nfc_default, hal_secure_element)
allow hal_secure_element_default { nfc_device radio_device }:chr_file rw_file_perms;
get_prop(hal_secure_element_default, vendor_rild_prop)

# Thermal HAL
r_dir_file(hal_thermal_default, { sysfs_thermal sysfs_pg sysfs_devices_system_cpu })
allow hal_thermal_default proc_stat:file r_file_perms;
allow hal_thermal_default sysfs:dir r_dir_perms;

# IR & Vibrator
allow hal_ir_default vendor_irda_device:chr_file rw_file_perms;
r_dir_file(hal_ir_default, sysfs_type)
allow hal_ir_default sysfs:file rw_file_perms;

allow hal_vibrator_default vendor_haptic_device:chr_file rw_file_perms;
r_dir_file(hal_vibrator_default, sysfs_type)
allow hal_vibrator_default { sysfs sysfs_vibrator sysfs_leds }:file rw_file_perms;

# Power, Perf & Memtrack HALs
set_prop(hal_power_default, vendor_power_prop)
allow hal_memtrack_default proc_gpu_memory:file r_file_perms;
allow { hal_power_default vendor_hal_hisi_perf_default } vendor_perf_ctrl_device:chr_file rw_file_perms;
r_dir_file({ hal_power_default vendor_hal_hisi_perf_default }, sysfs_type)
allow { hal_power_default vendor_hal_hisi_perf_default } {
    sysfs
    sysfs_devices_system_cpu
    sysfs_thermal
    sysfs_pg
    sysfs_gpu
    sysfs_power
    sysfs_devfreq_cur
    sysfs_devfreq_dir
}:file rw_file_perms;

# Camera HAL (CameraDaemon)
vndbinder_use(hal_camera_default)
allow hal_camera_default self:process execmem;
allow hal_camera_default self:global_capability_class_set sys_nice;
allow hal_camera_default graphics_device:dir search;
allow hal_camera_default {
    graphics_device
    gpu_device
    vendor_cambuf_device
    vendor_fd_device
    vendor_ipu_device
    vendor_ivp_device
    vendor_jpu_device
}:chr_file rw_file_perms;
allow hal_camera_default {
    vendor_dmd_device
    vendor_hwlog_device
}:chr_file { getattr open write };
allow hal_camera_default { cameraserver system_server hal_graphics_composer_default }:fd use;
allow hal_camera_default vendor_data_file:dir search;
allow hal_camera_default { vendor_camera_data_file vendor_logcat_data_file }:dir create_dir_perms;
allow hal_camera_default { vendor_camera_data_file vendor_logcat_data_file }:file create_file_perms;
r_dir_file(hal_camera_default, { sysfs_pg sysfs_camerafs sysfs_huawei_sensor sysfs_leds sysfs_devfreq_dir })
allow { hal_camera_default vendor_hal_hisi_hwfactoryinterface_default } sysfs_hisi_boardname:file r_file_perms;
allow hal_camera_default { proc_hisi_ddr_info proc_meminfo }:file r_file_perms;
allow hal_camera_default sysfs_pg:file w_file_perms;
allow hal_camera_default { sysfs_camerafs sysfs_leds }:file rw_file_perms;
get_prop(hal_camera_default, logd_prop)
dontaudit hal_camera_default default_prop:file r_file_perms;
dontaudit hal_camera_default config_prop:file r_file_perms;
dontaudit hal_camera_default shell_data_file:dir search;
set_prop(hal_camera_default, vendor_camera_prop)

# Sensors HAL (sensorhub)
allow hal_sensors_default sensors_device:chr_file rw_file_perms;
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file r_file_perms;
allow hal_sensors_default vendor_logcat_data_file:dir create_dir_perms;
allow hal_sensors_default vendor_logcat_data_file:file create_file_perms;
r_dir_file(hal_sensors_default, sysfs_huawei_sensor)
allow hal_sensors_default sysfs_huawei_sensor:file rw_file_perms;

# Audio HAL
r_dir_file(hal_audio_default, sysfs_audio_hw_config)
r_dir_file(hal_audio_default, sysfs_framebuffer)
r_dir_file(hal_audio_default, sysfs_batteryinfo)
r_dir_file(hal_audio_default, sysfs_huawei_sensor)
allow hal_audio_default sysfs_huawei_sensor:file rw_file_perms;
allow hal_audio_default radio_device:chr_file rw_file_perms;
allow hal_audio_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow hal_audio_default vendor_logcat_data_file:dir create_dir_perms;
allow hal_audio_default vendor_logcat_data_file:file create_file_perms;
dontaudit hal_audio_default { default_prop config_prop }:file r_file_perms;

# Bluetooth & Wi-Fi NVE MAC files
r_dir_file(hal_bluetooth_default, vendor_bluedroid_data_file)
allow hal_bluetooth_default proc_bluetooth_writable:dir r_dir_perms;
dontaudit hal_bluetooth_default shell_data_file:dir search;
r_dir_file(hal_wifi_default, vendor_wlan_data_file)
allow { hal_wifi_supplicant_default hal_wifi_hostapd_default } vendor_wlan_data_file:dir search;

# GNSS HAL & companion daemon binder/data channels
allow hal_gnss_default vendor_gps_device:chr_file rw_file_perms;
allow hal_gnss_default vendor_data_file:dir search;
allow hal_gnss_default { vendor_gps_data_file vendor_logcat_data_file }:dir create_dir_perms;
allow hal_gnss_default vendor_gps_data_file:{ file fifo_file sock_file } create_file_perms;
allow hal_gnss_default vendor_logcat_data_file:file create_file_perms;
r_dir_file(hal_gnss_default, proc_gps)
allow hal_gnss_default proc_gps:file rw_file_perms;
allow hal_gnss_default proc_wakeup_sources:file r_file_perms;
r_dir_file(hal_gnss_default, sysfs_hisi_connectivity)
set_prop(hal_gnss_default, vendor_gps_prop)
binder_call(hal_gnss_default, vendor_hisi_connectivity)
binder_call(vendor_hisi_connectivity, hal_gnss_default)

# Fingerprint HAL
allow hal_fingerprint_default vendor_fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default { vendor_dmd_device vendor_hwlog_device }:chr_file { getattr open write };
