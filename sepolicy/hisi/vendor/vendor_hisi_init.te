type vendor_hisi_init, domain;
type vendor_hisi_init_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_hisi_init)

allow vendor_hisi_init block_device:dir search;
allow vendor_hisi_init { block_device vendor_nve_block_device }:lnk_file r_file_perms;
allow vendor_hisi_init vendor_nve_block_device:blk_file r_file_perms;
allow vendor_hisi_init proc_cmdline:file r_file_perms;
allow vendor_hisi_init vendor_data_file:dir search;
allow vendor_hisi_init { vendor_bluedroid_data_file vendor_wlan_data_file }:dir rw_dir_perms;
allow vendor_hisi_init { vendor_bluedroid_data_file vendor_wlan_data_file }:file create_file_perms;
set_prop(vendor_hisi_init, vendor_hisi_conn_prop)
get_prop(vendor_init, vendor_hisi_conn_prop)
dontaudit vendor_hisi_init proc:file r_file_perms;
