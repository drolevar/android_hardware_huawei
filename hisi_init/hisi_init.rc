on post-fs-data
    # Create the directories used by Bluetooth and Wi-Fi MAC provisioning
    mkdir /data/vendor/bluedroid 0770 bluetooth bluetooth
    mkdir /data/vendor/wifi 0770 wifi wifi

on property:vendor.conn_macs.ready=1
    # Bluetooth
    chown bluetooth bluetooth /data/vendor/bluedroid/macbt
    chmod 0664 /data/vendor/bluedroid/macbt

    # Wi-Fi
    chown wifi wifi /data/vendor/wifi/macwlan
    chmod 0664 /data/vendor/wifi/macwlan

service vendor.hisi_init /vendor/bin/hisi_init
    class main
    user root
    group system bluetooth wifi
    oneshot
