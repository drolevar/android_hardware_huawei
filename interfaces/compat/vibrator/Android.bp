// SPDX-License-Identifier: Apache-2.0

package {
    default_applicable_licenses: ["huawei_compat_vibrator_license"],
}

license {
    name: "huawei_compat_vibrator_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

// The legacy Huawei extensions need only this removed AOSP package. Do not
// redefine android.hardware or combine both roots in one hidl-gen invocation.
hidl_package_root {
    name: "android.hardware.vibrator",
    use_current: true,
    require_frozen: true,
}
